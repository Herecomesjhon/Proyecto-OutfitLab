generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Item {
  id          String    @id @default(cuid())
  name        String
  description String?
  brand       String?
  color       String?
  size        String?
  season      String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId  String?
  images      Image[]
  tags        ItemTag[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Category {
  id    String @id @default(cuid())
  name  String @unique
  items Item[]
}

model Image {
  id        String   @id @default(cuid())
  url       String
  mime      String?
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    String
  createdAt DateTime @default(now())
}

model Tag {
  id    String    @id @default(cuid())
  name  String    @unique
  items ItemTag[]
}

model ItemTag {
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId  String

  @@id([itemId, tagId])
}

model Usuario {
  id                String             @id @default(cuid())
  email             String             @unique
  password          String?
  name              String?
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  authProviders     AuthProvider[]
  prendas           Prenda[]
  outfits           Outfit[]           @relation("UsuarioOutfits")
  outfitCollections OutfitCollection[] @relation("UsuarioOutfitCollections")

  // 🔹 Relación con posts de Explorar
  explorePosts ExplorePost[]

  // 🔹 NUEVOS: back-relations para likes y comentarios en Explorar
  exploreLikes    ExploreLike[]
  exploreComments ExploreComment[]

  @@map("usuario")
}

model AuthProvider {
  id         String  @id @default(cuid())
  provider   String
  providerId String  @map("provider_id")
  user       Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String  @map("user_id")

  @@unique([provider, providerId])
  @@index([userId])
  @@map("auth_providers")
}

// ACTUALIZADO CON CLASIFICACIÓN IA
model Prenda {
  id          Int            @id @default(autoincrement())
  user        Usuario        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String         @map("user_id")
  imageUrl    String         @map("image_url")
  type        String? // tipo manual (opcional)
  color       String? // color (opcional)
  category    String? // categoría clasificada por IA
  brand       String? // marca (opcional)
  confidence  Float? // confianza de clasificación IA (0-1)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  outfitItems OutfitPrenda[] @relation("PrendaOutfitItems")

  @@index([userId], map: "idx_clothes_user")
  @@index([category])
  @@map("clothes")
}

model Like {
  id        Int      @id @default(autoincrement())
  userId    String
  prendaId  Int
  createdAt DateTime @default(now())

  @@unique([userId, prendaId])
  @@index([userId])
  @@index([prendaId])
}

model OutfitCollection {
  id          String   @id @default(cuid())
  user        Usuario  @relation("UsuarioOutfitCollections", fields: [userId], references: [id], onDelete: Cascade)
  userId      String   @map("user_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  outfits Outfit[]

  @@map("outfit_collection")
}

model Outfit {
  id           String            @id @default(cuid())
  user         Usuario           @relation("UsuarioOutfits", fields: [userId], references: [id], onDelete: Cascade)
  userId       String            @map("user_id")
  collection   OutfitCollection? @relation(fields: [collectionId], references: [id])
  collectionId String?           @map("collection_id")
  name         String?
  occasion     String?
  dressCode    String?
  weather      String?
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  items        OutfitPrenda[]
  photos       OutfitPhoto[]
  explorePosts ExplorePost[]

  @@map("outfit")
}

model OutfitPrenda {
  outfit   Outfit @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  outfitId String @map("outfit_id")

  prenda   Prenda @relation("PrendaOutfitItems", fields: [prendaId], references: [id], onDelete: Cascade)
  prendaId Int    @map("prenda_id")

  @@id([outfitId, prendaId])
  @@map("outfit_prenda")
}

model OutfitPhoto {
  id  String @id @default(cuid())
  url String @default("") // 👈 valor por defecto para filas viejas

  outfit   Outfit @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  outfitId String @map("outfit_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("outfit_photo")
}

model ExplorePost {
  id String @id @default(cuid())

  outfit   Outfit @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  outfitId String @map("outfit_id")

  user   Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String  @map("user_id")

  title     String
  imageUrl  String   @map("image_url")
  likes     Int      @default(0) // contador total (lo mantenemos)
  saves     Int      @default(0)
  style     String? // Casual / Formal / Deportivo / etc.
  createdAt DateTime @default(now()) @map("created_at")

  // 👇 NUEVAS relaciones
  likesList ExploreLike[]
  comments  ExploreComment[]

  @@map("explore_post")
}

model ExploreLike {
  id        String      @id @default(cuid())
  user      Usuario     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String      @map("user_id")
  post      ExplorePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String      @map("post_id")
  createdAt DateTime    @default(now()) @map("created_at")

  @@unique([userId, postId])
  @@map("explore_like")
}

model ExploreComment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  user   Usuario     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String      @map("user_id")
  post   ExplorePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String      @map("post_id")

  @@map("explore_comment")
}
